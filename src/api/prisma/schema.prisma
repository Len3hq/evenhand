// Evenhand data model. The prose version, with the reasoning behind each constraint,
// is DATA-MODEL.md at the repo root. Change both together.
//
// Conventions
// - Tables and columns are snake_case in SQL (@@map / @map); fields are camelCase in TypeScript.
// - Primary keys are UUIDv7 (time-ordered, index-friendly). Rows imported from fixtures.json
//   also keep their fixture id in `external_id`, so exports and checker URLs line up.
// - Constraints Prisma cannot express (partial unique index, CHECK/triggers, the append-only
//   audit log) are hand-written SQL in the migrations. Each has a test proving it fires.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased; unique across the platform.
  email        String   @unique
  name         String
  /// argon2id. Null means the account cannot log in with a password yet.
  passwordHash String?  @map("password_hash")
  /// Platform-wide administrator. Event roles live in EventRole.
  isAdmin      Boolean  @default(false) @map("is_admin")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions       Session[]
  apiTokens      ApiToken[]
  eventRoles     EventRole[]
  teamMembers    TeamMember[]
  auditEntries   AuditLog[]
  judgeInvites   JudgeInvite[]
  comments       Comment[]     @relation("CommentAuthor")
  hiddenComments Comment[]     @relation("CommentHiddenBy")
  ballots        Ballot[]

  @@map("users")
}

/// Browser session. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Bearer token for API clients and scripts. Only the SHA-256 is stored.
/// Demo tokens (fixed values printed at boot) are refused unless DEMO_MODE=true.
model ApiToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  label     String
  isDemo    Boolean   @default(false) @map("is_demo")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id                 String    @id @default(uuid(7)) @db.Uuid
  externalId         String?   @unique @map("external_id")
  slug               String    @unique
  name               String
  opensAt            DateTime? @map("opens_at") @db.Timestamptz(3)
  /// Submissions are accepted only while now < submissions_close (server clock, UTC).
  submissionsClose   DateTime  @map("submissions_close") @db.Timestamptz(3)
  judgingClose       DateTime? @map("judging_close") @db.Timestamptz(3)
  resultsPublishedAt DateTime? @map("results_published_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tracks          Track[]
  prizes          Prize[]
  roles           EventRole[]
  criteria        Criterion[]
  teams           Team[]
  teamMembers     TeamMember[]
  submissions     Submission[]
  customQuestions CustomQuestion[]
  duplicateFlags  DuplicateFlag[]
  rankingRuns     RankingRun[]
  auditEntries    AuditLog[]
  judgeInvites    JudgeInvite[]
  votingRound     VotingRound?

  @@map("events")
}

model Track {
  id         String  @id @default(uuid(7)) @db.Uuid
  eventId    String  @map("event_id") @db.Uuid
  externalId String? @map("external_id")
  name       String

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prizes      Prize[]
  judgeTracks JudgeTrack[]
  submissions Submission[]

  @@unique([eventId, externalId])
  @@unique([eventId, name])
  @@map("tracks")
}

model Prize {
  id          String  @id @default(uuid(7)) @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  /// Null = an overall prize; set = a prize for one track.
  trackId     String? @map("track_id") @db.Uuid
  name        String
  description String?

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("prizes")
}

enum EventRoleKind {
  PARTICIPANT
  JUDGE
  ORGANIZER

  @@map("event_role_kind")
}

/// Roles are per event: the same person can judge one event and compete in another.
/// Visitor = no role; admin = users.is_admin.
model EventRole {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  eventId    String        @map("event_id") @db.Uuid
  role       EventRoleKind
  /// Fixture judge id (e.g. jdg_24) for judges imported from fixtures.json.
  externalId String?       @map("external_id")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeTracks JudgeTrack[]
  assignments Assignment[]
  conflicts   ConflictOfInterest[]

  @@unique([userId, eventId, role])
  @@unique([eventId, externalId])
  @@index([eventId, role])
  @@map("event_roles")
}

/// The tracks a judge may see and score (track isolation).
model JudgeTrack {
  judgeRoleId String @map("judge_role_id") @db.Uuid
  trackId     String @map("track_id") @db.Uuid

  judgeRole EventRole @relation(fields: [judgeRoleId], references: [id], onDelete: Cascade)
  track     Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([judgeRoleId, trackId])
  @@map("judge_tracks")
}

/// One rubric criterion. Weights are relative (normalised by their sum when scoring).
model Criterion {
  id      String @id @default(uuid(7)) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  key     String
  label   String
  weight  Float  @default(1)
  min     Int    @default(1)
  max     Int    @default(5)
  order   Int    @default(0)

  event  Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scores CriterionScore[]

  @@unique([eventId, key])
  @@map("criteria")
}

// ─── Teams and submissions ───────────────────────────────────────────────────

model Team {
  id         String   @id @default(uuid(7)) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  externalId String?  @map("external_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invites     Invite[]
  submissions Submission[]
  conflicts   ConflictOfInterest[]

  @@unique([eventId, externalId])
  @@map("teams")
}

/// event_id is denormalised from the team so the database can enforce
/// "a user is on at most one team per event" with a plain unique constraint.
model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  eventId  String   @map("event_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@unique([eventId, userId])
  @@map("team_members")
}

/// Invite link. The URL carries a random token; only its SHA-256 is stored.
model Invite {
  id        String   @id @default(uuid(7)) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  maxUses   Int      @default(4) @map("max_uses")
  uses      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("invites")
}

/// Judge invite link for an event. Like team invites, the URL carries a random token and only
/// its SHA-256 is stored. Whoever accepts becomes a JUDGE of the event covering `track_ids`
/// (tracks deleted since are skipped). Created by the event's organisers.
model JudgeInvite {
  id          String   @id @default(uuid(7)) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  trackIds    String[] @default([]) @map("track_ids") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  maxUses     Int      @default(1) @map("max_uses")
  uses        Int      @default(0)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("judge_invites")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED

  @@map("submission_status")
}

enum Eligibility {
  ELIGIBLE
  DISQUALIFIED

  @@map("eligibility")
}

/// A project submission. One live submission per team per event is enforced by a partial
/// unique index (migration SQL) on (event_id, team_id) WHERE superseded_by_id IS NULL AND
/// NOT duplicate_hold. `duplicate_hold` marks the older copy of an imported duplicate that is
/// waiting for the organiser's decision (BUILD-PLAN decisions 4–7, ADR 0004).
model Submission {
  id               String           @id @default(uuid(7)) @db.Uuid
  eventId          String           @map("event_id") @db.Uuid
  teamId           String           @map("team_id") @db.Uuid
  trackId          String?          @map("track_id") @db.Uuid
  externalId       String?          @map("external_id")
  /// Position in fixtures.json; the gallery's default order (checker check 2).
  seedOrder        Int?             @map("seed_order")
  title            String
  tagline          String?
  summary          String?
  description      String?
  thumbnailUrl     String?          @map("thumbnail_url")
  repoUrl          String?          @map("repo_url")
  demoVideoUrl     String?          @map("demo_video_url")
  liveUrl          String?          @map("live_url")
  techTags         String[]         @default([]) @map("tech_tags")
  status           SubmissionStatus @default(DRAFT)
  eligibility      Eligibility      @default(ELIGIBLE)
  disqualifyReason String?          @map("disqualify_reason")
  submittedAt      DateTime?        @map("submitted_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  supersededById   String?          @map("superseded_by_id") @db.Uuid
  duplicateHold    Boolean          @default(false) @map("duplicate_hold")

  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team           Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  track          Track?            @relation(fields: [trackId], references: [id], onDelete: SetNull)
  supersededBy   Submission?       @relation("Supersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Submission[]      @relation("Supersedes")
  images         SubmissionImage[]
  answers        Answer[]
  assignments    Assignment[]
  keptFlags      DuplicateFlag[]   @relation("DuplicateKept")
  duplicateFlags DuplicateFlag[]   @relation("DuplicateSuperseded")
  movedReviews   Review[]          @relation("ReviewOriginalSubmission")
  rankingRows    RankingRow[]
  comments       Comment[]
  votes          Vote[]

  @@unique([eventId, externalId])
  @@index([eventId, status, eligibility])
  @@index([teamId])
  @@map("submissions")
}

/// An image a team uploaded. The file is re-encoded by the API (WebP, metadata removed) and
/// stored as `<id>.webp` and `<id>-thumb.webp` in UPLOADS_DIR; `url` is where the API serves it.
/// The first by `order` is the project's cover. CHECKs in the migration keep the sizes sane.
model SubmissionImage {
  id           String   @id @default(uuid(7)) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  url          String
  order        Int      @default(0)
  /// Pixel size of the stored (re-encoded) full image.
  width        Int
  height       Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_images")
}

/// Organiser-defined question every submission answers (T1 field set). Answers are private to
/// the team, the event's organisers and the judges unless the question is public.
model CustomQuestion {
  id         String  @id @default(uuid(7)) @db.Uuid
  eventId    String  @map("event_id") @db.Uuid
  /// Set when imported from an export, so export → import → export keeps the same ids.
  externalId String? @map("external_id")
  prompt     String
  required   Boolean @default(false)
  /// Shown with the project in the public gallery.
  isPublic   Boolean @default(false) @map("is_public")
  order      Int     @default(0)

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([eventId, externalId])
  @@index([eventId])
  @@map("custom_questions")
}

model Answer {
  submissionId String @map("submission_id") @db.Uuid
  questionId   String @map("question_id") @db.Uuid
  value        String

  submission Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   CustomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([submissionId, questionId])
  @@map("answers")
}

enum DuplicateReason {
  SAME_TEAM
  SAME_REPO
  SAME_TITLE

  @@map("duplicate_reason")
}

enum DuplicateStatus {
  PENDING
  CONFIRMED
  DISMISSED

  @@map("duplicate_status")
}

/// A suspected duplicate: `kept` is the later submission, `superseded` the earlier one.
/// Confirming sets superseded.superseded_by_id = kept and moves unique reviews across.
model DuplicateFlag {
  id           String          @id @default(uuid(7)) @db.Uuid
  eventId      String          @map("event_id") @db.Uuid
  keptId       String          @map("kept_id") @db.Uuid
  supersededId String          @map("superseded_id") @db.Uuid
  reason       DuplicateReason
  status       DuplicateStatus @default(PENDING)
  decidedById  String?         @map("decided_by_id") @db.Uuid
  decidedAt    DateTime?       @map("decided_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kept       Submission @relation("DuplicateKept", fields: [keptId], references: [id], onDelete: Cascade)
  superseded Submission @relation("DuplicateSuperseded", fields: [supersededId], references: [id], onDelete: Cascade)

  @@unique([keptId, supersededId])
  @@map("duplicate_flags")
}

// ─── Judging ─────────────────────────────────────────────────────────────────

/// A judge may not be assigned to a team they have a conflict with.
model ConflictOfInterest {
  judgeRoleId String  @map("judge_role_id") @db.Uuid
  teamId      String  @map("team_id") @db.Uuid
  reason      String?

  judgeRole EventRole @relation(fields: [judgeRoleId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([judgeRoleId, teamId])
  @@map("conflicts_of_interest")
}

model Assignment {
  id            String   @id @default(uuid(7)) @db.Uuid
  judgeRoleId   String   @map("judge_role_id") @db.Uuid
  submissionId  String   @map("submission_id") @db.Uuid
  /// Which release wave this belongs to, e.g. "fixture" or "batch-2".
  batch         String
  /// Position in this judge's (shuffled) queue.
  queuePosition Int      @map("queue_position")
  assignedAt    DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  judgeRole  EventRole  @relation(fields: [judgeRoleId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  review     Review?

  @@unique([judgeRoleId, submissionId])
  @@index([submissionId])
  @@map("assignments")
}

enum ReviewStatus {
  DRAFT
  FINAL

  @@map("review_status")
}

/// One review per assignment. `superseded` reviews (from a merged duplicate) are kept for the
/// record but excluded from ranking.
model Review {
  id                   String       @id @default(uuid(7)) @db.Uuid
  assignmentId         String       @unique @map("assignment_id") @db.Uuid
  status               ReviewStatus @default(DRAFT)
  comment              String       @default("")
  superseded           Boolean      @default(false)
  /// Set when a duplicate merge moved this review from another submission.
  originalSubmissionId String?      @map("original_submission_id") @db.Uuid
  /// Null for reviews imported from fixtures.json, which carry no timestamps.
  submittedAt          DateTime?    @map("submitted_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignment         Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  originalSubmission Submission?      @relation("ReviewOriginalSubmission", fields: [originalSubmissionId], references: [id], onDelete: SetNull)
  scores             CriterionScore[]

  @@map("reviews")
}

/// A value inside [criterion.min, criterion.max]; enforced by a trigger in the migration.
model CriterionScore {
  reviewId    String @map("review_id") @db.Uuid
  criterionId String @map("criterion_id") @db.Uuid
  value       Int

  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@id([reviewId, criterionId])
  @@map("criterion_scores")
}

// ─── Results ─────────────────────────────────────────────────────────────────

/// A frozen ranking computation: its inputs hash, parameters and outputs (the Ranking Receipt).
model RankingRun {
  id          String    @id @default(uuid(7)) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  method      String
  /// Weights, λ_b, λ_q and any other parameter needed to reproduce the run.
  params      Json
  inputsHash  String    @map("inputs_hash")
  outputHash  String    @map("output_hash")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rows  RankingRow[]

  @@index([eventId])
  @@map("ranking_runs")
}

model RankingRow {
  runId        String @map("run_id") @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  rawMean      Float  @map("raw_mean")
  normalized   Float
  posteriorSd  Float  @map("posterior_sd")
  rank         Int
  tieGroup     Int    @map("tie_group")
  nReviews     Int    @map("n_reviews")
  reason       String

  run        RankingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([runId, submissionId])
  @@map("ranking_rows")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

/// Append-only. There is no update or delete path in code, and a trigger (migration SQL)
/// rejects UPDATE and DELETE at the database level.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  eventId    String?  @map("event_id") @db.Uuid
  /// domain.verb, e.g. "auth.login", "submission.updated". Listed in core/audit-actions.ts.
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  before     Json?
  after      Json?
  ip         String?
  /// Hash chain, filled by the database on insert (trigger audit_log_chain, migration
  /// *_audit_hash_chain); never set by the application. `prev_hash` is the previous entry's
  /// `hash` (64 zeros for the first); `hash` is SHA-256 of this entry's canonical JSON,
  /// prev_hash included. Both unique: a second entry claiming the same predecessor is a fork.
  prevHash   String?  @unique @map("prev_hash")
  hash       String?  @unique

  /// RESTRICT, not SET NULL: a cascade would UPDATE audit rows, which the trigger forbids.
  /// Users and events with audit history are therefore never hard-deleted.
  actor User?  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, at])
  @@index([actorId])
  @@map("audit_log")
}

// ─── Community ────────────────────────────────────────────────────────────────

/// A comment on a project in the public gallery (T3). Anyone logged in may post on a public
/// project; the event's organisers can hide one, with a reason, and restore it. Hidden comments
/// are kept, never deleted, so moderation is reversible and auditable. The body length is
/// checked in the database too (migration).
model Comment {
  id           String    @id @default(uuid(7)) @db.Uuid
  submissionId String    @map("submission_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  body         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(3)
  hiddenById   String?   @map("hidden_by_id") @db.Uuid
  hideReason   String?   @map("hide_reason")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User       @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  hiddenBy   User?      @relation("CommentHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
  @@map("comments")
}

// ─── Community voting (T3) ────────────────────────────────────────────────────

/// Who may vote in a community vote.
enum VotingMode {
  /// Anyone logged in: one ballot per account.
  ACCOUNTS
  /// "Email-gated": one personal voting link per email the organisers list.
  EMAIL_LIST
  /// One shared link that hands each visitor a personal voting link.
  OPEN_LINK

  @@map("voting_mode")
}

/// An event's community vote. Votes count only between opens_at and closes_at (server clock).
/// Tallies are for organisers until the vote has closed and they publish the results.
/// CHECKs in the migration: closes_at after opens_at, 1 to 10 votes per voter.
model VotingRound {
  id                 String     @id @default(uuid(7)) @db.Uuid
  eventId            String     @unique @map("event_id") @db.Uuid
  mode               VotingMode
  opensAt            DateTime   @map("opens_at") @db.Timestamptz(3)
  closesAt           DateTime   @map("closes_at") @db.Timestamptz(3)
  /// How many different projects one voter may vote for.
  votesPerVoter      Int        @default(1) @map("votes_per_voter")
  /// OPEN_LINK: SHA-256 of the shared link's secret.
  linkTokenHash      String?    @unique @map("link_token_hash")
  resultsPublishedAt DateTime?  @map("results_published_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  passes  VoterPass[]
  ballots Ballot[]

  @@map("voting_rounds")
}

/// A personal voting link: for a listed email (EMAIL_LIST) or handed out by the open link
/// (OPEN_LINK, no email). Only the SHA-256 of its secret is stored.
model VoterPass {
  id        String   @id @default(uuid(7)) @db.Uuid
  roundId   String   @map("round_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  email     String?
  /// Open-link passes only: the address that took it, so organisers can see ballots taken by
  /// one address more than once. Never sent to the web.
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  round  VotingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  ballot Ballot?

  @@unique([roundId, email])
  @@map("voter_passes")
}

/// One voter's ballot in a round: an account (ACCOUNTS) or a voting link (the other modes),
/// never both (CHECK). One ballot per account and per link, enforced by unique indexes.
model Ballot {
  id        String   @id @default(uuid(7)) @db.Uuid
  roundId   String   @map("round_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  passId    String?  @unique @map("pass_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  round VotingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pass  VoterPass?  @relation(fields: [passId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@unique([roundId, userId])
  @@map("ballots")
}

/// A vote for one project on one ballot: at most one per project per ballot (primary key).
model Vote {
  ballotId     String   @map("ballot_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ballot     Ballot     @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([ballotId, submissionId])
  @@index([submissionId])
  @@map("votes")
}

/// The audit chain's head (one row, id = 1): the newest entry's hash. Maintained only by the
/// audit_log_chain trigger; the application reads it, never writes it.
model AuditChainHead {
  id   Int    @id @default(1)
  hash String

  @@map("audit_chain_head")
}
