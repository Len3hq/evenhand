# Copy to .env for local development (`cp .env.example .env`).
# docker compose does NOT read this file for the api container; compose sets its own values.

# Postgres exposed by compose.dev.yml on host port 5433
DATABASE_URL=postgresql://evenhand:evenhand@localhost:5433/evenhand
# Separate database used by the e2e suite (created automatically by the db container init script)
TEST_DATABASE_URL=postgresql://evenhand:evenhand@localhost:5433/evenhand_test

# true = seed fixed demo tokens + demo passwords and print them on boot. NEVER true in production.
DEMO_MODE=true
# Password given to every seeded account when DEMO_MODE=true
DEMO_PASSWORD=evenhand-demo

# Origins allowed to make cookie-authenticated writes (CSRF defence). Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# API listen port
PORT=3001

# Rate limits (requests per minute)
RATE_LIMIT_DEFAULT_PER_MIN=300
RATE_LIMIT_LOGIN_PER_MIN=10

# Web (Next.js dev server) → where /api/* is proxied and where server components fetch from
API_REWRITE_TARGET=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
