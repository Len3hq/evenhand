{
  "name": "@evenhand/api",
  "version": "0.1.0",
  "private": true,
  "description": "Evenhand REST API (NestJS). Every permission, deadline and audit rule lives here.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && nest build",
    "dev": "prisma generate && prisma migrate deploy && nest build && node --env-file-if-exists=../../.env dist/cli/cli.js seed && nest start --watch --preserveWatchOutput --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "prisma generate && nest build && vitest run --config vitest.e2e.config.ts",
    "db:reset": "prisma migrate reset --force && npm run cli -- seed",
    "migrate:dev": "prisma migrate dev",
    "cli": "nest build && node --env-file-if-exists=../../.env dist/cli/cli.js",
    "openapi": "nest build && node dist/cli/cli.js openapi openapi.json"
  },
  "dependencies": {
    "@evenhand/judging-engine": "0.1.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "csv-stringify": "6.9.0",
    "dotenv": "18.0.4",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pg": "8.23.0",
    "supertest": "7.3.0",
    "vitest": "4.1.11"
  }
}
